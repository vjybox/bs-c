# Copy to `.env` next to docker-compose.yml to override the defaults.
# Every value here already has a working default for running on your own machine —
# you only need this file when the app is reached at some address other than localhost.

# The address you actually type into a browser. Share links and QR codes are generated
# from this, so on a NAS or any remote host it MUST be that host's address, not localhost.
# Examples: WEB_BASE_URL=http://192.168.1.50:8080  (home network only)
#           WEB_BASE_URL=https://yourname.synology.me  (Synology DDNS + reverse proxy)
WEB_BASE_URL=http://localhost:8080

# Host port for the web UI. Change it if something else already holds 8080 —
# on Synology DSM, Web Station and a few other packages commonly do.
WEB_PORT=8080

# Postgres password. Letters and digits only: it is embedded in a connection URL, where
# characters like @ : / # break it. Postgres reads it only when its data volume is first
# created, so set it BEFORE the first start; changing it later locks the app out.
POSTGRES_PASSWORD=change-me

# Demo mode: loads seven sample people and enables "Sign in as a demo persona". Their
# sign-in tokens are committed to git, so anyone who can reach the app can use them. Fine
# for a test with fake data; set false (or delete the line) before real people use it.
DEMO_MODE=false

# Backups land in ./backups next to this file. Daily by default; around an event, where a
# day of lost captures would hurt, set 3600 for hourly.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
